NODE_ENV=development
PORT=4000

# MongoDB local (docker compose) hoặc MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/focusly

# Đổi thành chuỗi ngẫu nhiên dài (vd: openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_EXTENSION_SECRET=change-me-extension-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Các origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000
# URL Web dùng để tạo link đặt lại mật khẩu
WEB_URL=http://localhost:3000
# URL public của chính backend (dùng cho avatar lưu local)
PUBLIC_API_URL=http://localhost:4000

# Google Login: danh sách Client ID được chấp nhận (Web + Android), phân tách bằng dấu phẩy
GOOGLE_CLIENT_IDS=

# Email (để trống => link reset được in ra console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FOCUSLY <no-reply@focusly.app>"

# Cloudinary (để trống => avatar lưu tại thư mục uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Phase 2: Notifications ----------
# Firebase service account (JSON) mã hoá base64: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Tắt bộ nhắc lịch định kỳ (vd khi chạy nhiều instance)
ENABLE_SCHEDULER=true

# ---------- Phase 3: AI Learning Assistant ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_REQUESTS_PER_HOUR=40
