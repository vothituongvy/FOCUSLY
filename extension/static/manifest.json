{
  "manifest_version": 3,
  "name": "FOCUSLY Focus Shield",
  "version": "2.1.0",
  "description": "Chặn website gây xao nhãng khi bạn đang học với FOCUSLY (đồng bộ với Web & Mobile).",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FOCUSLY Focus Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://focusly-web.vercel.app/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "style.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
